# ============================================================================
# SYNTHETIX - ENVIRONMENT VARIABLES
# ============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env files to version control!
# ============================================================================

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# For local development (SQLite - no setup required)
DATABASE_URL=sqlite:///./agentic.db

# For production (PostgreSQL recommended)
# DATABASE_URL=postgresql://username:password@host:5432/database_name
# Example with Neon PostgreSQL:
# DATABASE_URL=postgresql://user:password@ep-cool-cloud-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# ============================================================================
# REDIS CACHE (Required for production, optional for development)
# ============================================================================
# Upstash Redis (recommended for serverless/production)
UPSTASH_REDIS_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_TOKEN=your_upstash_redis_token_here

# Local Redis (for development)
# UPSTASH_REDIS_URL=redis://localhost:6379

# ============================================================================
# LLM PROVIDER CONFIGURATION (Required)
# ============================================================================
# Provider options: groq, openai, anthropic
LLM_PROVIDER=groq

# Groq API Key (get from https://console.groq.com)
LLM_API_KEY=gsk_your_groq_api_key_here

# Model selection based on provider:
# Groq models: llama-3.3-70b-versatile, llama-3.1-70b-versatile, mixtral-8x7b-32768
# OpenAI models: gpt-4, gpt-3.5-turbo
LLM_MODEL=llama-3.3-70b-versatile

# ============================================================================
# SYNTHETIC DATA GENERATION SETTINGS
# ============================================================================
# Maximum optimization iterations before accepting best result
MAX_ITERATIONS=5

# Quality threshold (0.0 to 1.0) - higher means stricter quality requirements
# Recommended: 0.65 for balanced quality/speed, 0.75 for high quality
QUALITY_THRESHOLD=0.65

# ============================================================================
# FILE STORAGE CONFIGURATION
# ============================================================================
# Local storage path for uploaded and generated files
FILE_STORAGE_PATH=./storage

# Maximum upload file size in megabytes
MAX_UPLOAD_SIZE_MB=100

# ============================================================================
# EMAIL SERVICE (Optional - for user verification emails)
# ============================================================================
# Resend API Key (get from https://resend.com)
# Leave empty to disable email verification
RESEND_API_KEY=re_your_resend_api_key_here

# ============================================================================
# JWT AUTHENTICATION & SECURITY
# ============================================================================
# Secret key for JWT tokens - MUST be changed in production!
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# JWT algorithm (recommended: HS256)
ALGORITHM=HS256

# Token expiration time in minutes
# 43200 = 30 days, 10080 = 7 days, 1440 = 1 day
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# ============================================================================
# CORS CONFIGURATION (Optional)
# ============================================================================
# Allowed origins for CORS (comma-separated)
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://yourdomain.com

# ============================================================================
# LOGGING & MONITORING (Optional)
# ============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# LOG_LEVEL=INFO

# Sentry DSN for error tracking (optional)
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ============================================================================
# WORKER CONFIGURATION (Optional - for background jobs)
# ============================================================================
# Celery broker URL (if using Celery for async tasks)
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ============================================================================
# DEVELOPMENT FLAGS (Optional)
# ============================================================================
# Enable debug mode (never use in production!)
# DEBUG=False

# Environment name
# ENVIRONMENT=development

# ============================================================================
# GOOGLE OAUTH 2.0 CONFIGURATION (Required for authentication)
# ============================================================================
# Get from: https://console.cloud.google.com/apis/credentials
# 1. Create OAuth 2.0 Client ID
# 2. Add authorized origins: http://localhost:3000, https://yourdomain.com
# 3. Add authorized redirect URIs (if needed)

GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id_here

# ============================================================================
# CLOUDINARY FILE STORAGE (Required for production file uploads)
# ============================================================================
# Get from: https://cloudinary.com/console
# Free tier: 25GB storage, 25GB bandwidth/month

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here

# ============================================================================
# PRODUCTION DEPLOYMENT URLS
# ============================================================================
# Backend API URL (Railway, Render, etc.)
# IMPORTANT: Do NOT include /api suffix - frontend routes already include it
# Correct:   https://your-backend.railway.app
# Incorrect: https://your-backend.railway.app/api
VITE_API_URL=https://your-backend-url.railway.app

# Frontend URL (Vercel, Netlify, etc.)
# Used by backend for CORS configuration
FRONTEND_URL=https://your-frontend-url.vercel.app
